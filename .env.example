# Leave blank on a public site: each visitor signs in or enters their own token.
# Optional personal token for a private, access-restricted deployment only.
# Never use NEXT_PUBLIC_ for secrets.
DVDD_API_KEY=

# Required on Netlify: keep a stable secret across all serverless instances.
# Set through Netlify environment variables with Functions scope (and Builds).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
